    "method": "POST",
    "path": "/api/v1/merchant/orders/demo-order-001/verify",
    "body": {
      "requestId": "demo-verify-001",
      "expectedVersion": 4,
      "pickupCode": "DEMO-572913"
    }
  },
  "response": {
    "status": 200,
    "body": {
      "data": {
        "id": "demo-order-001",
        "items": [
          {
            "dishId": "demo-dish-01",
            "name": "演示鸡肉饭",
            "quantity": 1,
            "unitPriceFen": 1800
          }
        ],
        "slotId": "demo-slot-20261113-lunch",
        "slotStart": "2026-11-13T11:30:00+08:00",
        "slotEnd": "2026-11-13T12:00:00+08:00",
        "diningMode": "DINE_IN",
        "diningModeReason": null,
        "totalFen": 1800,
        "status": "COMPLETED",
        "paymentStatus": "SIMULATED_PAID",
        "cancelRequest": {
          "status": "NONE",
          "reason": null
        },
        "cancellationReason": null,
        "version": 5,
        "createdAt": "2026-11-13T11:15:00+08:00",
        "updatedAt": "2026-11-13T11:40:00+08:00",
        "pickedUpAt": "2026-11-13T11:40:00+08:00",
        "delay": null,
        "pickupCode": null
      }
    }
  },
  "repeatRule": "同一requestId重试返回首次成功；新requestId再次核销返回PICKUP_CODE_USED，不再次消费取餐码。",
  "retryCases": [
    {
      "requestId": "demo-verify-001",
      "expectedVersion": 4,
      "pickupCode": "DEMO-572913",
      "expectedResult": "返回第一次成功结果，不再执行核销"
    },
    {
      "requestId": "demo-verify-002",
      "expectedVersion": 4,
      "pickupCode": "DEMO-572913",
      "expectedHttpStatus": 409,
      "expectedCode": "PICKUP_CODE_USED"
    }
  ],
  "pendingCancellationVariant": {
    "before": { "status": "READY", "cancelRequest": { "status": "PENDING", "reason": "演示申请取消" } },
    "afterSuccessfulVerification": { "status": "COMPLETED", "cancelRequest": { "status": "REJECTED", "reason": "订单已取餐" } },
    "note": "取餐完成与结束待处理申请必须在同一次操作内保存；此处只是预期示例。"
  }
